{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ramtinj95/opencode-tokenscope",
  "version": "2.1.0",
  "description": "OpenCode plugin for detailed token usage analysis with breakdowns by category, visual charts, and subagent cost tracking",
  "type": "module",
  "main": "./dist/tokenscope.js",
  "types": "./dist/tokenscope.d.ts",
  "exports": {
    ".": {
      "types": "./dist/v2/tokenscope.d.ts",
      "import": "./dist/v2/tokenscope.js"
    },
    "./tui": "./dist/v2/tui.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "build:tui": "bun scripts/build-tui.ts",
    "test": "bun test && npm run test:dist",
    "test:dist": "npm run build && npm run build:tui && node -e \"await import('./dist/tokenscope.js'); await import('./dist/v2/tokenscope.js')\"",
    "prepublishOnly": "npm run build && npm run build:tui",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tui.json"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "tokens",
    "token-usage",
    "analysis",
    "cost-tracking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramtinj95/opencode-tokenscope.git"
  },
  "bugs": {
    "url": "https://github.com/ramtinj95/opencode-tokenscope/issues"
  },
  "homepage": "https://github.com/ramtinj95/opencode-tokenscope#readme",
  "author": "ramtinj95",
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.1.48",
    "@opencode/plugin": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "js-tiktoken": "^1.0.15"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.13",
    "@opencode/plugin": "2.2.6",
    "@opencode/theme": "2.2.6",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "solid-js": "1.9.17",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist/",
    "models.json",
    "tokenscope-config.json",
    "README.md",
    "LICENSE"
  ]
}
